[
  {
    "label": "lazygit",
    "command": "lazygit -p $GRAM_WORKTREE_ROOT",
    "hide": "on_success",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "shell": {
      "program": "sh"
    }
  },
  {
    "label": "file_finder",
    "command": "gram \"$(tv files)\"",
    "hide": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": true,
    "shell": {
      "program": "/bin/bash"
    }
  },
  {
    "label": "text_finder",
    "command": "gram \"$(tv text)\"",
    "hide": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": true,
    "shell": {
      "program": "/bin/bash"
    }
  }
]
